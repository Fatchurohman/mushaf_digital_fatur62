// FUNGSI PENGAMBILAN DATA MAPPING SURAH SECARA AMAN (VALIDASI & ERROR HANDLING)
function getSurahMapping(surahNumber) {
  try {
    if (!surahNumber || isNaN(surahNumber)) {
      throw new Error("Nomor surah tidak valid.");
    }
    
    const mapping = SURAH_MAPPING[surahNumber];
    if (!mapping) {
      return {
        nama: "Tidak Diketahui",
        arti: "-",
        kategori: "-",
        topik_utama: "Data pemetaan tematik belum tersedia untuk surah ini.",
        pemetaan_ayat: []
      };
    }
    return mapping;
  } catch (error) {
    console.error("Gagal mengambil data pemetaan surah:", error);
    return null;
  }
}
